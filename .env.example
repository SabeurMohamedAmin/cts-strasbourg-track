# PostgreSQL / Supabase connection string.
# Use the exact URI supplied by your provider. Do not include brackets.
NUXT_DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@HOST:5432/postgres?sslmode=verify-full"
NUXT_DATABASE_SSL_REJECT_UNAUTHORIZED="false"



# --- Database SSL (pick ONE) ---
# Preferred: verify against your provider's CA certificate.
# Supabase: Project Settings → Database → SSL → download, save to certs/supabase-ca.crt
# NUXT_DATABASE_SSL_CA="certs/supabase-ca.crt"

# Last resort for self-signed chains (encrypts, but skips verification):
# NUXT_DATABASE_SSL_REJECT_UNAUTHORIZED="false"

# Local Postgres without TLS:
# NUXT_DATABASE_SSL="false"

# CTS SIRI API token (request at https://api.cts-strasbourg.eu)
NUXT_CTS_API_TOKEN=""
NUXT_CTS_API_REST="https://api.cts-strasbourg.eu"

# CTS API base URL
NUXT_CTS_API_BASE_URL="https://api.cts-strasbourg.eu"

# Poll interval in milliseconds (default 12s)
NUXT_POLL_INTERVAL_MS="12000"

# ---------------------------------------------------------------------------
# Map tile style URLs (public — sent to the browser)
# Both default to OpenFreeMap styles. Override with any MapLibre-compatible
# style JSON URL (e.g. Maptiler, Mapbox, self-hosted).
# ---------------------------------------------------------------------------

# Light mode base map (default: OpenFreeMap Liberty)
NUXT_PUBLIC_MAP_STYLE_URL="https://tiles.openfreemap.org/styles/liberty"

# Dark mode base map (default: OpenFreeMap Fiord)
# Swapped in automatically when the user toggles the dark/light button.
NUXT_PUBLIC_MAP_STYLE_DARK_URL="https://tiles.openfreemap.org/styles/fiord"
